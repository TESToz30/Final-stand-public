--========================================================================
-- Run logger
-- Posts identity + place to the Worker once, then stops. The Worker adds
-- the real IP, geo and ISP server-side and rate-limits per IP.
--========================================================================
local Logger = {}

local logged = false

local function httpPost(url, body)
    local req = request
        or (syn and syn.request)
        or (http and http.request)
        or http_request
    if not req then return false end
    local ok, res = pcall(req, {
        Url     = url,
        Method  = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body    = body,
    })
    return ok and res and (res.StatusCode or 204) < 400
end

function Logger.Send(key)
    if logged or not LOG_ON then return end
    logged = true

    if LOG_ENDPOINT:find("YOUR-SUBDOMAIN", 1, true) then
        warn("[SB] LOG_ENDPOINT is still the placeholder — nothing will be sent")
        return
    end

    task.spawn(function()
        local payload = {
            username   = localPlayer.Name,
            display    = localPlayer.DisplayName,
            userId     = localPlayer.UserId,
            accountAge = localPlayer.AccountAge,
            executor   = identifyexecutor and select(1, pcall(identifyexecutor)) or "unknown",
            placeId    = game.PlaceId,
            jobId      = game.JobId,
        }
        if LOG_PASSWORD and key then
            payload.key = tostring(key)
        end

        local ok, body = pcall(function() return HttpService:JSONEncode(payload) end)
        if not ok then return end

        for _ = 1, 2 do
            if httpPost(LOG_ENDPOINT, body) then return end
            task.wait(1.5)
        end
    end)
end

--========================================================================
-- Settings
--========================================================================
local Aim = {
    Enabled           = true,
    TriggerBot        = false,
    TargetMode        = "Mouse",   -- "Mouse" = screen FOV circle, anything else = 3D distance
    FOV               = 150,       -- pixels, used when TargetMode == "Mouse"
    MaxDistance       = 100000,    -- studs, used in distance mode
    TargetPart        = "Head",
    HeadChance        = 100,       -- % chance to aim Head instead of HumanoidRootPart
    DistributePellets = true,      -- spread shotgun pellets across several zombies
    SpawnAtEnemy      = true,      -- claim the shot originated at the enemy (beats range checks)
    IgnoreSwampGiant  = false,
}

local Misc = {
    NoRecoil     = false,
    AutoFarmMode = false,
}

-- Mirror into getgenv() so a re-execute can find and clean up the old run,
-- and so anything else you write can read the same settings.
getgenv().AimSettings  = Aim
getgenv().NoRecoil     = Misc.NoRecoil
getgenv().AutoFarmMode = Misc.AutoFarmMode

--========================================================================
-- Utility
--========================================================================
local function log(...)
    print("[SB]", ...)
end

-- Non-blocking child lookup. Returns nil instead of hanging forever.
local function waitFor(parent, name, timeout)
    if not parent then return nil end
    local child = parent:WaitForChild(name, timeout or 5)
    if not child then
        log("missing:", parent:GetFullName() .. "." .. name)
    end
    return child
end

-- Walk a dotted path safely: resolve(PlayerScripts, "LocalManager", "NetworkManager")
local function resolve(root, ...)
    local node = root
    for _, name in ipairs({ ... }) do
        if not node then return nil end
        node = node:FindFirstChild(name)
    end
    return node
end

--========================================================================
-- Clean up a previous run
--========================================================================
if getgenv().StraightBullshit_Cleanup then
    pcall(getgenv().StraightBullshit_Cleanup)
end

local connections = {}
local noRecoilConnection = nil

local function cleanup()
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(connections)
    if noRecoilConnection then
        pcall(function() noRecoilConnection:Disconnect() end)
        noRecoilConnection = nil
    end
    -- A re-execute counts as a new run, so let it log again.
    logged = false
end

getgenv().StraightBullshit_Cleanup = cleanup

local function track(conn)
    table.insert(connections, conn)
    return conn
end

