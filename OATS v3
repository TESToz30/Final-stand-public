local playerScripts = waitFor(localPlayer, "PlayerScripts", 10)
local zombiesFolder = waitFor(Workspace, "Zombies", 10)

local packetRemote
do
    local remoteEvents = waitFor(ReplicatedStorage, "RemoteEvents", 10)
    packetRemote = remoteEvents and waitFor(remoteEvents, "PacketRemote", 10)
end

-- The old source did: require(PlayerScripts.LocalManager.NetworkManager)
-- with plain dot indexing, which ERRORS outright if the game moved it.
local networkManager
do
    local module = resolve(playerScripts, "LocalManager", "NetworkManager")
    if module then
        if setthreadidentity then setthreadidentity(2) end
        local ok, result = pcall(require, module)
        if setthreadidentity then setthreadidentity(8) end
        if ok then
            networkManager = result
        else
            log("NetworkManager require failed:", result)
        end
    else
        log("NetworkManager not found — packet sanitiser disabled")
    end
end

-- Player level / prestige, used only for display. Optional.
local function readPlayerStats()
    local level, prestige = "N/A", "N/A"
    pcall(function()
        local dataScript = resolve(playerScripts, "LocalDataStore")
        local env
        if dataScript and getsenv then
            local ok, result = pcall(getsenv, dataScript)
            env = ok and result or nil
        end
        local globals = (env and env._G) or (getrenv and getrenv()._G)
        local store = globals and globals.LocalReplicatedDataStore
        if store then
            level    = tostring(store.Level or "N/A")
            prestige = tostring(store.Prestige or "N/A")
        end
    end)
    return level, prestige
end

--========================================================================
-- Packet sanitiser
-- Incoming WeaponAttack payloads carry 8-character hex keys that the
-- server uses to validate the shot. The original stripped them.
--========================================================================
local function stripHexKeys(payload)
    local target = payload and payload[3] and payload[3][3]
    if type(target) ~= "table" then return end

    local doomed
    for key in pairs(target) do
        if type(key) == "string" and #key == 8 and key:match("^%x+$") then
            doomed = doomed or {}
            table.insert(doomed, key)
        end
    end
    if doomed then
        for _, key in ipairs(doomed) do
            rawset(target, key, nil)
        end
    end
end

if networkManager and networkManager.PassData and hookfunction then
    local originalPassData
    originalPassData = hookfunction(networkManager.PassData, function(...)
        local args = table.pack(...)
        if args[2] == "WeaponAttack" then
            pcall(stripHexKeys, args)
        end
        return originalPassData(table.unpack(args, 1, args.n))
    end)
    log("packet sanitiser installed")
end

--========================================================================
-- Target scanning
--========================================================================
-- Higher number = picked first.
local PRIORITY = {
    SniperZombie   = 5,
    Boss           = 4,
    Hunter         = 3,
    GuardianZombie = 2,
}

local function pickAimPart(zombie)
    local wantHead = math.random(1, 100) <= (Aim.HeadChance or 100)
    local part = zombie:FindFirstChild(wantHead and "Head" or "HumanoidRootPart")
    return part
        or zombie:FindFirstChild("HumanoidRootPart")
        or zombie:FindFirstChild("Head")
end

-- Returns a list of { part = BasePart, dist = number, priority = number },
-- best target first.
local function getTargets()
    if not Aim.Enabled or not zombiesFolder then return {} end

    local character = localPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return {} end

    local mousePos  = UserInputService:GetMouseLocation()
    local originPos = root.Position
    local useScreen = (Aim.TargetMode == "Mouse")

    local found = {}
    for _, zombie in ipairs(zombiesFolder:GetChildren()) do
        repeat
            if Aim.IgnoreSwampGiant and zombie.Name == "SwampGiant" then break end

            local part = pickAimPart(zombie)
            if not part then break end
            if zombie:FindFirstChild("ForceField") then break end

            local humanoid = zombie:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health <= 0 then break end

            local inRange, dist = false, nil
            if useScreen then
                local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    inRange = dist < Aim.FOV
                end
            else
                dist = (part.Position - originPos).Magnitude
                inRange = dist < Aim.MaxDistance
            end

            if inRange then
                table.insert(found, {
                    part     = part,
                    dist     = dist,
                    priority = PRIORITY[zombie.Name] or 1,
                })
            end
        until true
    end

    table.sort(found, function(a, b)
        if a.priority ~= b.priority then
            return a.priority > b.priority
        end
        return a.dist < b.dist
    end)
    return found
end

-- Refreshed every frame, read by the packet hook.
local primaryTarget = nil
local targetParts   = {}

track(RunService.Heartbeat:Connect(function()
    local targets = getTargets()
    primaryTarget = targets[1] and targets[1].part or nil

    local parts = {}
    for i, entry in ipairs(targets) do
        parts[i] = entry.part
    end
    targetParts = parts
end))

--========================================================================
-- Silent aim: rewrite the outgoing WeaponAttack packet
--========================================================================
local function rewriteAttack(packet)
    local attack = packet.WeaponAttack and packet.WeaponAttack[1]
    if not (attack and attack[3]) then return end

    -- attack[2] is the hit list; attack[3] carries ray info / crit rolls.
    local hits = attack[2]
    if not hits then
        hits = {}
        attack[2] = hits
    end

    -- Which zombies are we claiming to have hit?
    local chosen = {}
    if Aim.DistributePellets and #targetParts > 0 then
        chosen = targetParts
    elseif primaryTarget then
        chosen = { primaryTarget }
    end
    if #chosen == 0 then return end

    -- One entry per pellet; a single bullet still counts as one.
    local pellets = #hits
    if pellets == 0 then pellets = 1 end

    for i = 1, pellets do
        local part = chosen[((i - 1) % #chosen) + 1]
        if part then
            local pos = vector.create(part.Position.X, part.Position.Y, part.Position.Z)
            hits[i] = { part, pos, true }
        end
    end

    -- Claim the shot started at the enemy, so distance checks pass.
    if Aim.SpawnAtEnemy then
        local first = chosen[1]
        local pos = vector.create(first.Position.X, first.Position.Y, first.Position.Z)
        attack[3].RayOriginPos = pos
        packet.CharPos = pos
        packet.LookPos = pos
    end

    -- Force every pellet to crit.
    if attack[3].CriticalRolls then
        for i = 1, pellets do
            attack[3].CriticalRolls[i] = true
        end
    end
end

if packetRemote and hookmetamethod then
    local originalNamecall
    originalNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if getnamecallmethod() == "FireServer" and self == packetRemote then
            local args = table.pack(...)
            local packet = args[1]
            if Aim.Enabled and type(packet) == "table" and packet.WeaponAttack then
                pcall(rewriteAttack, packet)
            end
            return originalNamecall(self, table.unpack(args, 1, args.n))
        end
        return originalNamecall(self, ...)
    end)
    log("silent aim installed")
else
    log("PacketRemote missing — silent aim disabled")
end

--========================================================================
-- Equipped weapon tracking
-- No Recoil needs to know which tool you are holding. The game parents
-- the Tool into your Character while it is equipped.
--========================================================================
local equippedToolName = nil
local reequipping      = false   -- true while we are mid unequip/equip

local function watchCharacter(character)
    if not character then return end

    track(character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            equippedToolName = child.Name
        end
    end))

    track(character.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") and child.Name == equippedToolName then
            -- Our own re-equip removes the tool for a moment; keep the name.
            if reequipping then return end
            equippedToolName = nil
        end
    end))

    -- Not in the original: pick up a tool that is already equipped at load,
    -- otherwise No Recoil does nothing until you next switch weapons.
    local held = character:FindFirstChildOfClass("Tool")
    if held then
        equippedToolName = held.Name
    end
end

watchCharacter(localPlayer.Character)

track(localPlayer.CharacterAdded:Connect(function(character)
    equippedToolName = nil
    watchCharacter(character)
end))

-- Unequip then re-equip the held weapon so the game rebuilds its
-- CurrentValues. The original did this on every No Recoil toggle.
local function reequipWeapon()
    local character = localPlayer.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end

    local name = tool.Name
    reequipping = true

    humanoid:UnequipTools()
    task.wait(0.1)

    local fromBackpack = localPlayer.Backpack:FindFirstChild(name)
    if fromBackpack then
        humanoid:EquipTool(fromBackpack)
    end

    task.wait(0.1)
    reequipping = false
end

--========================================================================
-- No Recoil
-- The game keeps live weapon spread in Tool.CurrentValues. Recoil is
-- just spread climbing as you fire, so holding SpreadIncrease and
-- ZoomSpreadIncrease at 0 every frame removes the kick entirely.
--========================================================================
local function clearSpread()
    if not equippedToolName then return end

    local character = localPlayer.Character
    local tool = character and character:FindFirstChild(equippedToolName)
    if not tool then return end

    local values = tool:FindFirstChild("CurrentValues")
    if not values then return end

    local spread = values:FindFirstChild("SpreadIncrease")
    if spread then
        spread.Value = 0
    end

    local zoomSpread = values:FindFirstChild("ZoomSpreadIncrease")
    if zoomSpread then
        zoomSpread.Value = 0
    end
end

local function setNoRecoil(enabled)
    Misc.NoRecoil      = enabled
    getgenv().NoRecoil = enabled

    if noRecoilConnection then
        noRecoilConnection:Disconnect()
        noRecoilConnection = nil
    end

    if enabled then
        noRecoilConnection = RunService.RenderStepped:Connect(clearSpread)
    end

    -- Re-equip so the weapon picks up (or loses) the zeroed values.
    task.spawn(reequipWeapon)
end

--========================================================================
-- Trigger bot
-- There is no "shoot" remote to call directly. The game listens to its
-- own mobile Attack button, so this fires that button's connections:
-- MouseButton1Down to start shooting, InputEnded + MouseButton1Up to stop.
--========================================================================
local attackButton     = nil
local lastButtonLookup = 0
local triggerHolding   = false
local holdStartedAt    = 0

-- Cached, because walking PlayerGui every frame is wasteful. Re-looks up
-- at most twice a second, same as the original.
local function findAttackButton()
    if attackButton and attackButton.Parent then
        return attackButton
    end

    local now = tick()
    if now - lastButtonLookup < 0.5 then
        return attackButton
    end
    lastButtonLookup = now

    attackButton = resolve(localPlayer:FindFirstChild("PlayerGui"),
        "ScreenGui", "TouchControls", "RightSide", "AttackButton")
    return attackButton
end

local function fireAll(signal)
    if not signal then return end
    for _, connection in pairs(getconnections(signal)) do
        connection:Fire()
    end
end

local function pressAttack(button)
    fireAll(button.MouseButton1Down)
end

local function releaseAttack(button)
    fireAll(button.InputEnded)
    pcall(function()
        fireAll(button.MouseButton1Up)
    end)
end

local function stopHolding()
    local button = attackButton
    if button and button.Parent then
        releaseAttack(button)
    end
    triggerHolding = false
end

track(RunService.RenderStepped:Connect(function()
    -- Nothing in range: make sure the trigger is let go.
    if not primaryTarget then
        stopHolding()
        return
    end

    -- Target in range but the trigger bot is off: also let go.
    if not Aim.TriggerBot then
        stopHolding()
        return
    end

    local button = findAttackButton()
    if not button then return end

    if not triggerHolding then
        triggerHolding = true
        holdStartedAt  = tick()
        pressAttack(button)
    elseif tick() - holdStartedAt > 0 then
        -- Re-press every frame so automatic weapons keep cycling.
        holdStartedAt = tick()
        pressAttack(button)
    end
end))

