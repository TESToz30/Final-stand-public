local PERK_CATEGORIES = {
    "DefensivePerks", "EconomyPerks", "HybridPerks",
    "OffensivePerks", "UtilityPerks",
}

local function getPerksRoot()
    return resolve(ReplicatedStorage,
        "MenuGui", "UnlocksFrame", "Unlocks", "MobileTest", "Perks")
end

local function buyAllPerks()
    local perksRoot = getPerksRoot()
    if not perksRoot then
        return false, "perk menu not found"
    end

    local prestigePerk = resolve(ReplicatedStorage, "RemoteFunctions", "PrestigePerk")
    if not prestigePerk then
        return false, "PrestigePerk remote not found"
    end

    local names = {}
    for _, category in ipairs(PERK_CATEGORIES) do
        local group = perksRoot:FindFirstChild(category)
        local perks = group and group:FindFirstChild("Perks")
        if perks then
            for _, button in ipairs(perks:GetChildren()) do
                if button:IsA("ImageButton") then
                    table.insert(names, button.Name)
                end
            end
        end
    end

    for _, name in ipairs(names) do
        task.spawn(function()
            pcall(function() prestigePerk:InvokeServer(name) end)
        end)
        task.wait(0.025)
    end
    return true, #names .. " perk(s) attempted"
end

-- Equip a saved perk loadout (slots 1-5).
local perkLoadoutSlot = 1
local function equipPerkLoadout(slot)
    slot = tonumber(slot) or perkLoadoutSlot or 1
    local remote = resolve(ReplicatedStorage, "RemoteEvents", "RemotePerkLoadout")
    if not remote then
        return false, "RemotePerkLoadout not found"
    end
    local ok = pcall(function() remote:FireServer(2, slot) end)
    if ok then
        return true, "equipped loadout " .. slot
    end
    return false, "failed to fire loadout " .. slot
end

--========================================================================
-- DPS panel
--========================================================================
local function parseStat(str)
    if type(str) ~= "string" then return nil end
    local base = tonumber(str:match("^([%d%.]+)"))
    local mult = tonumber(str:match("%*(%d+)")) or 1
    local x    = tonumber(str:match("%(x([%d%.]+)%)")) or 1
    if not base then return nil end
    return base * mult * x
end

local function computeDPS(damageStr, speedStr, holdType, clipStr, reloadStr, consumeStr)
    local damage = parseStat(damageStr)
    local speed  = parseStat(speedStr)
    if not damage or not speed then return 0, 0 end

    local clip    = parseStat(clipStr)
    local reload  = parseStat(reloadStr)
    local consume = parseStat(consumeStr) or 1

    local perSecond = speed > 0 and (1 / speed) or 0
    local low  = damage * perSecond
    local high = low

    if clip and reload and reload > 0 then
        local shotsPerClip = math.max(1, clip / consume)
        local burst = shotsPerClip * speed
        low = (damage * shotsPerClip) / (burst + reload)
    end

    if holdType then
        low, high = low * 2, high * 2
    end
    return math.floor(low + 0.5), math.floor(high + 0.5)
end

local dpsConnection = nil

local function startDPSPanel()
    if dpsConnection then return end

    dpsConnection = RunService.RenderStepped:Connect(function()
        local stats = resolve(localPlayer:FindFirstChild("PlayerGui"),
            "ScreenGui", "ShopFrame", "Information", "StatsFrame", "Frame", "Stats")
        if not stats then return end

        local damage = stats:FindFirstChild("Damage")
        local speed  = stats:FindFirstChild("AttackSpeed")

        if not (damage and speed and damage.Visible and speed.Visible) then
            local old = stats:FindFirstChild("DPS")
            if old then old.Visible = false end
            return
        end

        local row = stats:FindFirstChild("DPS")
        if not row then
            local template = stats:FindFirstChild("StatTemplate")
            if not template then return end
            row = template:Clone()
            row.Name = "DPS"
            row.Stat.Text = "DPS: "
            row.Value.Text = "0"
            row.Value.TextColor3 = Color3.fromRGB(255, 200, 40)
            row.LayoutOrder = 99
            row.Parent = stats
        end

        local function text(stat)
            return stat and stat.Visible and stat:FindFirstChild("Value") and stat.Value.Text or nil
        end

        local holdTypeStat = stats:FindFirstChild("HoldType")
        local holdType = holdTypeStat and holdTypeStat.Visible
            and holdTypeStat:FindFirstChild("Value")
            and holdTypeStat.Value.Text == "Yes"

        local low, high = computeDPS(
            damage.Value.Text, speed.Value.Text, holdType,
            text(stats:FindFirstChild("MaxClip")),
            text(stats:FindFirstChild("ReloadSpeed")),
            text(stats:FindFirstChild("Consume")))

        row.Value.Text = (low == high) and tostring(low)
            or string.format("%d (%d)", low, high)
        row.Visible = true
    end)
    track(dpsConnection)
end

local function stopDPSPanel()
    if dpsConnection then
        dpsConnection:Disconnect()
        dpsConnection = nil
    end
end

