-- Auto-farm helpers
--========================================================================
local farm = {
    noclipSelf   = false,
    autoReload   = false,
    teleToAmmo   = false,
    voteSkip     = false,
    fullAuto     = false,
}
local reloadCooldown = 0
local voteCooldown   = 0
local originalFireType = {}

local function getAmmoBox()
    local lid = resolve(Workspace, "Map", "Upgrades", "AmmoBox", "InvisLid")
    return lid
end

local function pressReload()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.delay(0.1, function()
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    end)
end

track(RunService.Stepped:Connect(function()
    if not farm.noclipSelf then return end
    local character = localPlayer.Character
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end))

track(RunService.Heartbeat:Connect(function()
    if not farm.teleToAmmo then return end
    local character = localPlayer.Character
    local humanoid  = character and character:FindFirstChildOfClass("Humanoid")
    local root      = character and character:FindFirstChild("HumanoidRootPart")
    if not (humanoid and root) then return end
    local lid = getAmmoBox()
    if lid and (root.Position - lid.Position).Magnitude > 5 then
        humanoid:MoveTo(lid.Position)
    end
end))

track(RunService.RenderStepped:Connect(function()
    if not farm.autoReload or not equippedToolName then return end

    local now = tick()
    if now - reloadCooldown < 0.1 then return end

    local lid = getAmmoBox()
    local root = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not (lid and root and (root.Position - lid.Position).Magnitude <= 15) then return end

    local tool = localPlayer.Character:FindFirstChild(equippedToolName)
    local values = tool and tool:FindFirstChild("CurrentValues")
    if not values then return end

    local clip    = values:FindFirstChild("Clip")
    local ammo    = values:FindFirstChild("Ammo")
    local maxClip = values:FindFirstChild("MaxClip")
    if not (clip and ammo and maxClip) then return end

    local c, a, m = clip.Value, ammo.Value, maxClip.Value
    local shouldReload
    if a == 0 then
        shouldReload = c < m * 0.3
    else
        shouldReload = (a <= c) or (c + a < m)
    end

    if shouldReload then
        reloadCooldown = now
        pressReload()
    end
end))

track(RunService.RenderStepped:Connect(function()
    if not farm.voteSkip then return end

    local button = resolve(localPlayer:FindFirstChild("PlayerGui"),
        "ScreenGui", "GameFrame", "Core", "WeaponFrame", "VoteSkip")
    if not (button and button.Visible) then return end
    if not button.Text:find("Ready Up") then return end

    local now = tick()
    if now - voteCooldown < 3 then return end

    pcall(function()
        local skipGui = require(resolve(localPlayer:FindFirstChild("PlayerScripts"),
            "GuiManager", "MainGui", "SkipGui"))
        if skipGui and not skipGui.Voted then
            voteCooldown = now
            skipGui:Vote()
        end
    end)
end))

track(RunService.Heartbeat:Connect(function()
    if not farm.fullAuto or not equippedToolName then return end
    local tool = localPlayer.Character and localPlayer.Character:FindFirstChild(equippedToolName)
    local values = tool and tool:FindFirstChild("CurrentValues")
    local fireType = values and values:FindFirstChild("FireType")
    if not fireType then return end

    if originalFireType[equippedToolName] == nil then
        originalFireType[equippedToolName] = fireType.Value
    end
    if fireType.Value ~= "FullAuto" then
        fireType.Value = "FullAuto"
    end
end))

local function restoreFireTypes()
    local character = localPlayer.Character
    for name, original in pairs(originalFireType) do
        local tool = character and character:FindFirstChild(name)
        local values = tool and tool:FindFirstChild("CurrentValues")
        local fireType = values and values:FindFirstChild("FireType")
        if fireType then
            pcall(function() fireType.Value = original end)
        end
    end
    table.clear(originalFireType)
end

--========================================================================
-- RunGun perk
--========================================================================
local runGunAdded = false

local function setRunGun(enabled)
    if not playerPerks then return end
    if enabled then
        if not playerPerks:FindFirstChild("RunGun") then
            local value = Instance.new("NumberValue")
            value.Name  = "RunGun"
            value.Value = 1
            value.Parent = playerPerks
            runGunAdded = true
        end
    elseif runGunAdded then
        local value = playerPerks:FindFirstChild("RunGun")
        if value then value:Destroy() end
        runGunAdded = false
    end
end

--========================================================================
-- FOV circle (Drawing API, visual only)
--========================================================================
local fovCircleOn = true
local fovCircle   = nil

if typeof(Drawing) == "table" or type(Drawing) == "table" then
    local ok, circle = pcall(function()
        local c = Drawing.new("Circle")
        c.Thickness    = 2
        c.NumSides     = 64
        c.Filled       = false
        c.Transparency = 1
        c.Visible      = false
        return c
    end)
    if ok then fovCircle = circle end
end

if fovCircle then
    local AMBER = Color3.fromRGB(255, 200, 40)
    local RED   = Color3.fromRGB(255, 60, 30)

    track(RunService.RenderStepped:Connect(function()
        if not (fovCircleOn and Aim.Enabled and Aim.TargetMode == "Mouse") then
            fovCircle.Visible = false
            return
        end
        local mouse = UserInputService:GetMouseLocation()
        fovCircle.Position = mouse
        fovCircle.Radius   = Aim.FOV
        fovCircle.Color    = primaryTarget and RED or AMBER
        fovCircle.Visible  = true
    end))

    track({ Disconnect = function()
        if fovCircle then pcall(function() fovCircle:Remove() end) end
    end })
end

--========================================================================
-- Invisible (your own character only)
--========================================================================
local invisible = false
local originalTransparency = {}

local function restoreVisible()
    for part, t in pairs(originalTransparency) do
        if part and part.Parent then
            pcall(function() part.Transparency = t end)
        end
    end
    table.clear(originalTransparency)
end

local function setInvisible(state)
    invisible = state
    if not state then restoreVisible() end
end

track(RunService.Heartbeat:Connect(function()
    if not invisible then return end
    local character = localPlayer.Character
    if not character then return end
    for _, d in ipairs(character:GetDescendants()) do
        if (d:IsA("BasePart") or d:IsA("Decal")) and d.Transparency ~= 1 then
            if originalTransparency[d] == nil then
                originalTransparency[d] = d.Transparency
            end
            d.Transparency = 1
        end
    end
end))

track(localPlayer.CharacterAdded:Connect(function()
    table.clear(originalTransparency)
end))

